{\pard\slf0\sb240\sa120\keepn\flf1\b\f0\fs28 Slide 1: Current Architecture (Working)\par}
{\pard\slf0\sb100\sa100\flf0\fs20 Vault kv-2 Integration (2026-05-07)\par}
{\pard\slf0\sb80\sa80\li200\fi-200\flf0\fs18\bullet Vault Server: 192.168.2.57:8200\par}
{\pard\slf0\sb40\sa40\li200\fi-200\flf0\fs18\bullet Mount: ebiz_service (kv-v2)\par}
{\pard\slf0\sb40\sa40\li200\fi-200\flf0\fs18\bullet Secret Path: ebiz_db/data-enc-key\par}
{\pard\slf0\sb40\sa40\li200\fi-200\flf0\fs18\bullet Key: fernet-key (32 bytes)\par}
\pard\slf0\sb80\sa80\flf0\fs20\bullet Flow:\par}
{\pard\slf0\sb40\sa40\li400\fi-400\flf0\fs18 1. demoApp \rightarrow Spring Cloud Vault \rightarrow HashiCorp Vault\par}
{\pard\slf0\sb40\sa40\li400\fi-400\flf0\fs18 2. PasswordService reads Fernet key from Vault\par}
{\pard\slf0\sb40\sa40\li400\fi-400\flf0\fs18 3. AES-128 encryption with CBC mode\par}
{\pard\slf0\sb40\sa40\li400\fi-400\flf0\fs18 4. Base64 encoded output stored in database\par}
\page

{\pard\slf0\sb240\sa120\keepn\flf1\b\f0\fs28 Slide 2: Vault kv-2 Path Structure\par}
{\pard\slf0\sb100\sa100\flf0\fs20 Secret Path: ebiz_service/data/ebiz_db/data-enc-key\par}
\pard\slf0\sb80\sa80\flf0\fs20\bullet Vault CLI Commands:\par}
{\pard\slf0\sb40\sa40\li400\fi-400\flf1\fs16\b # Enable kv-2 backend\par}
{\pard\slf0\sb20\sa20\li600\fi-600\flf1\fs14 vault secrets enable -path=ebiz_service kv-v2\par}
{\pard\slf0\sb40\sa40\li400\fi-400\flf1\fs16\b # Store Fernet key\par}
{\pard\slf0\sb20\sa20\li600\fi-600\flf1\fs14 vault kv put -mount=ebiz_service ebiz_db/data-enc-key \\\par}
{\pard\slf0\sb10\sa10\li800\fi-800\flf1\fs14 fernet-key="NgqO..." description="encryption key..."\par}
{\pard\slf0\sb40\sa40\li400\fi-400\flf1\fs16\b # Read secret\par}
{\pard\slf0\sb20\sa20\li600\fi-600\flf1\fs14 vault kv get -mount=ebiz_service ebiz_db/data-enc-key\par}
\pard\slf0\sb80\sa80\flf0\fs20\bullet API Path: /v1/ebiz_service/data/ebiz_db/data-enc-key\par}
\page

{\pard\slf0\sb240\sa120\keepn\flf1\b\f0\fs28 Slide 3: Fernet Key Structure\par}
{\pard\slf0\sb100\sa100\flf0\fs20 Fernet Key (32 bytes total)\par}
\pard\slf0\sb80\sa80\flf0\fs18\b Bytes 0-15: AES-128 Key (16 bytes)\par}
{\pard\slf0\sb40\sa40\li200\fi-200\flf0\fs16 - Used for AES-128 encryption (CBC mode)\par}
\pard\slf0\sb80\sa80\flf0\fs18\b Bytes 16-31: HMAC-SHA256 Key (16 bytes)\par}
{\pard\slf0\sb40\sa40\li200\fi-200\flf0\fs16 - Currently unused (available for HMAC)\par}
\pard\slf0\sb80\sa80\flf0\fs20\bullet Format: URL-safe Base64 (uses '-' and '_')\par}
{\pard\slf0\sb40\sa40\li200\fi-200\flf0\fs16 Example: NgqOBievnB9500cQOnSQ-cmbBx38KnOiKx5ooQ_e97Y=\par}
\pard\slf0\sb80\sa80\flf0\fs20\bullet Decoded: 32 bytes binary data\par}
{\pard\slf0\sb40\sa40\li200\fi-200\flf0\fs16 - encryptionKey[0..15] \rightarrow AES-128 secret key\par}
{\pard\slf0\sb40\sa40\li200\fi-200\flf0\fs16 - encryptionKey[16..31] \rightarrow HMAC-SHA256 key (unused)\par}
\page

{\pard\slf0\sb240\sa120\keepn\flf1\b\f0\fs28 Slide 4: PasswordService Implementation\par}
{\pard\slf0\sb100\sa100\flf0\fs20 VaultOperations.read() Approach\par}
{\pard\slf0\sb80\sa80\flf1\fs14\b @Service\par}
{\pard\slf0\sb20\sa20\li200\fi-200\flf1\fs14 public class PasswordService {\par}
{\pard\slf0\sb10\sa10\li400\fi-400\flf1\fs14 private byte[] encryptionKey;\par}
{\pard\slf0\sb40\sa40\li200\fi-200\flf1\fs14\i // Constructor with VaultOperations injection\par}
{\pard\slf0\sb10\sa10\li400\fi-400\flf1\fs14 public PasswordService(VaultOperations vaultOps) {\par}
{\pard\slf0\sb10\sa10\li600\fi-600\flf1\fs14 this.vaultOperations = vaultOps;\par}
{\pard\slf0\sb10\sa10\li600\fi-600\flf1\fs14 loadEncryptionKey();\par}
{\pard\slf0\sb10\sa10\li400\fi-400\flf1\fs14 }\par}
{\pard\slf0\sb40\sa40\li200\fi-200\flf1\fs14\i // Read Fernet key from Vault kv-2\par}
{\pard\slf0\sb10\sa10\li400\fi-400\flf1\fs14 private void loadEncryptionKey() {\par}
{\pard\slf0\sb10\sa10\li600\fi-600\flf1\fs14 VaultResponse response = vaultOps.read("ebiz_service/data/ebiz_db/data-enc-key");\par}
{\pard\slf0\sb10\sa10\li600\fi-600\flf1\fs14 Map<String, Object> outerData = response.getData();\par}
{\pard\slf0\sb10\sa10\li600\fi-600\flf1\fs14 Map<String, Object> secretData = (Map<>) outerData.get("data");\par}
{\pard\slf0\sb10\sa10\li600\fi-600\flf1\fs14 String fernetKeyBase64 = (String) secretData.get("fernet-key");\par}
{\pard\slf0\sb10\sa10\li600\fi-600\flf1\fs14 this.encryptionKey = Base64.getUrlDecoder().decode(fernetKeyBase64);\par}
{\pard\slf0\sb10\sa10\li400\fi-400\flf1\fs14 }\par}
{\pard\slf0\sb10\sa10\li200\fi-200\flf1\fs14}\par}
\page

{\pard\slf0\sb240\sa120\keepn\flf1\b\f0\fs28 Slide 5: Encryption Flow\par}
{\pard\slf0\sb100\sa100\flf0\fs20 Password Encryption Process\par}
\pard\slf0\sb80\sa80\flf0\fs18 1. User Input: "vaulttest123"\par}
{\pard\slf0\sb40\sa40\li200\fi-200\flf0\fs16 ↓ PasswordService.encryptPassword()\par}
{\pard\slf0\sb40\sa40\li200\fi-200\flf0\fs16 ↓ Fernet Key (byte[32]) → AES-128 (first 16 bytes)\par}
{\pard\slf0\sb40\sa40\li200\fi-200\flf0\fs16 ↓ Cipher.doFinal(password.getBytes())\par}
{\pard\slf0\sb40\sa40\li200\fi-200\flf0\fs16 ↓ Base64.getEncoder().encodeToString()\par}
{\pard\slf0\sb40\sa40\li200\fi-200\flf0\fs16 ↓ Output: "pU4nAaBrwqPKLoV1Waa/tw=="\par}
{\pard\slf0\sb40\sa40\li200\fi-200\flf0\fs16 ↓ Stored in DB: ebiz.board.password\par}
\pard\slf0\sb80\sa80\flf0\fs18\i Verification (2026-05-07):\par}
{\pard\slf0\sb40\sa40\li200\fi-200\flf0\fs16 POST /api/v1/posts → Created post ID 2017587\par}
{\pard\slf0\sb40\sa40\li200\fi-200\flf0\fs16 DB check: password = "pU4nAaBrwqPKLoV1Waa/tw==" (encrypted)\par}
\page

{\pard\slf0\sb240\sa120\keepn\flf1\b\f0\fs28 Slide 6: VaultResponse Structure (kv-v2)\par}
{\pard\slf0\sb100\sa100\flf0\fs20 Spring Vault Read Response\par}
\pard\slf0\sb80\sa80\flf1\fs14\b Vault kv-2 Response Structure:\par}
{\pard\slf0\sb20\sa20\li200\fi-200\flf1\fs14 {\par}
{\pard\slf0\sb10\sa10\li400\fi-400\flf1\fs14 "data": {\par}
{\pard\slf0\sb10\sa10\li600\fi-600\flf1\fs14 "data": {\par}
{\pard\slf0\sb10\sa10\li800\fi-800\flf1\fs14 "description": "encryption key for ebiz db column",\par}
{\pard\slf0\sb10\sa10\li800\fi-800\flf1\fs14 "fernet-key": "NgqOBievnB9500cQOnSQ-..."\par}
{\pard\slf0\sb10\sa10\li600\fi-600\flf1\fs14 },\par}
{\pard\slf0\sb10\sa10\li400\fi-400\flf1\fs14 "metadata": { ... }\par}
{\pard\slf0\sb10\sa10\li200\fi-200\flf1\fs14 }\par}
{\pard\slf0\sb10\sa10\li200\fi-200\flf1\fs14}\par}
\pard\slf0\sb80\sa80\flf0\fs18\i Key Points:\par}
{\pard\slf0\sb40\sa40\li200\fi-200\flf0\fs16 - kv-v2 wraps data in double "data" fields\par}
{\pard\slf0\sb40\sa40\li200\fi-200\flf0\fs16 - Outer: response.getData() → Map\par}
{\pard\slf0\sb40\sa40\li200\fi-200\flf0\fs16 - Inner: outerData.get("data") → Secret data\par}
{\pard\slf0\sb40\sa40\li200\fi-200\flf0\fs16 - Actual key: secretData.get("fernet-key")\par}
\page

